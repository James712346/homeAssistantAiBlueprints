blueprint:
  name: Live Activity - Bus to Work
  description: >
    Live Activity countdown for a specific bus route at one stop. Runs only
    within the days/time window you set, and only while the chosen person
    is home - it clears itself the moment you leave home or the window
    ends. Updates immediately whenever the live arrival estimate changes
    (not on a fixed timer), shows a backup "next after" arrival alongside
    the primary one in case you miss it, and pulses a light once when the
    bus gets inside your threshold.

    Requires Home Assistant Core 2026.7.0+ and the companion app's Live
    Activities feature (Labs, TestFlight on iOS 17.2+).
  domain: automation
  input:
    notify_action:
      name: Notify Action
      description: >
        The exact notify action to call, e.g. notify.mobile_app_james_iphone.
        Leave blank to disable pushes entirely - there is no broadcast fallback.
      default: ""
      selector:
        text:
    person_entity:
      name: Person
      description: Only runs while this person is home; clears the activity the moment they leave.
      selector:
        entity:
          domain: person
    route_number:
      name: Bus Route Number
      description: Matched against the route_id attribute (the part before the dash), e.g. 196.
      selector:
        text:
    arrival_sensors:
      name: Arrival Sensors
      description: Pick all of this stop's arrival sensors (usually the "_1" through "_4" ones).
      selector:
        entity:
          domain: sensor
          multiple: true
    days:
      name: Days to Run
      default:
        - mon
        - tue
        - wed
        - thu
        - fri
      selector:
        select:
          multiple: true
          options:
            - mon
            - tue
            - wed
            - thu
            - fri
            - sat
            - sun
    start_time:
      name: Start Time
      default: "07:00:00"
      selector:
        time:
    end_time:
      name: End Time
      default: "09:00:00"
      selector:
        time:
    fallback_refresh_seconds:
      name: Fallback Refresh (seconds)
      description: >
        The activity updates immediately whenever the arrival sensors
        change - this is just a safety-net interval to recheck the
        schedule/presence conditions if nothing changes for a while.
      default: 60
      selector:
        number:
          min: 20
          max: 300
          step: 5
          unit_of_measurement: s
    bar_max_minutes:
      name: Progress Bar Max (minutes)
      default: 15
      selector:
        number:
          min: 5
          max: 60
          unit_of_measurement: min
    pulse_light_entity:
      name: Light to Pulse (optional)
      description: Leave blank to disable.
      default: ""
      selector:
        entity:
          domain: light
    pulse_threshold_minutes:
      name: Pulse When Bus Is Within (minutes)
      default: 5
      selector:
        number:
          min: 1
          max: 30
          unit_of_measurement: min
    activity_tag:
      name: Activity Tag
      default: bus_to_work
      selector:
        text:
    icon:
      name: Icon
      default: mdi:bus
      selector:
        text:
    color:
      name: Color
      default: "#3F51B5"
      selector:
        text:

mode: restart
max_exceeded: silent

trigger:
  - trigger: time
    at: !input start_time

variables:
  person_entity: !input person_entity
  route_number: !input route_number
  arrival_sensors: !input arrival_sensors
  days: !input days
  end_time: !input end_time
  fallback_refresh_seconds: !input fallback_refresh_seconds
  bar_max_minutes: !input bar_max_minutes
  pulse_light_entity: !input pulse_light_entity
  pulse_threshold_minutes: !input pulse_threshold_minutes
  activity_tag: !input activity_tag
  icon: !input icon
  color: !input color
  notify_service: !input notify_action
  has_pulsed: false

condition:
  - condition: time
    weekday: !input days
  # No notify action configured - do nothing (no broadcast fallback).
  - condition: template
    value_template: "{{ (notify_service | trim) != '' }}"

action:
  - variables:
      prev_signature: ""
  - repeat:
      while:
        - condition: template
          value_template: >-
            {{ now().time() < strptime(end_time, '%H:%M:%S').time() and is_state(person_entity, 'home') }}
      sequence:
        - variables:
            bus_matches: >-
              {% set ns = namespace(list=[]) %}
              {% for e in arrival_sensors %}
                {% set rid = state_attr(e, 'route_id') or '' %}
                {% set mins = states(e) | float(-1) %}
                {% if rid.split('-')[0] == route_number and mins >= 0 %}
                  {% set ns.list = ns.list + [mins | round(0)] %}
                {% endif %}
              {% endfor %}
              {{ ns.list | sort }}
            has_bus: "{{ bus_matches | length > 0 }}"
            next_bus_minutes: "{{ bus_matches[0] if has_bus else 'none' }}"
            after_next_minutes: "{{ bus_matches[1] if bus_matches | length > 1 else 'none' }}"
            bar_progress: >-
              {% if has_bus %}{{ [bar_max_minutes | float(0) - (next_bus_minutes | float(0)), 0] | max }}{% else %}0{% endif %}
            current_signature: "{{ next_bus_minutes ~ '|' ~ after_next_minutes }}"
        - if: "{{ current_signature != prev_signature }}"
          then:
            - action: "{{ notify_service }}"
              data:
                title: Bus to Work
                message: >-
                  {% if has_bus %}Route {{ route_number }} in {{ next_bus_minutes }} min{% if after_next_minutes != 'none' %} (next: {{ after_next_minutes }} min){% endif %}{% else %}No route {{ route_number }} arrival found{% endif %}
                data:
                  tag: "{{ activity_tag }}"
                  live_update: true
                  progress: "{{ bar_progress }}"
                  progress_max: "{{ bar_max_minutes }}"
                  chronometer: "{{ has_bus }}"
                  when: "{{ (next_bus_minutes | float(0) * 60) | round(0) if has_bus else 0 }}"
                  when_relative: true
                  notification_icon: "{{ icon }}"
                  notification_icon_color: "{{ color }}"
                  color: "{{ color }}"
            - variables:
                prev_signature: "{{ current_signature }}"
        - if: >-
            {{ pulse_light_entity and has_bus and not has_pulsed
               and next_bus_minutes | float(0) <= pulse_threshold_minutes | float(0) }}
          then:
            - variables:
                pulse_was_on: "{{ is_state(pulse_light_entity, 'on') }}"
                pulse_prior_brightness: "{{ state_attr(pulse_light_entity, 'brightness') }}"
            - repeat:
                count: 3
                sequence:
                  - action: light.turn_on
                    target:
                      entity_id: "{{ pulse_light_entity }}"
                    data:
                      brightness_pct: 100
                  - delay:
                      milliseconds: 500
                  - action: light.turn_off
                    target:
                      entity_id: "{{ pulse_light_entity }}"
                  - delay:
                      milliseconds: 500
            - if: "{{ pulse_was_on }}"
              then:
                - action: light.turn_on
                  target:
                    entity_id: "{{ pulse_light_entity }}"
                  data: >-
                    {% if pulse_prior_brightness not in [none, 'none'] %}{{ {'brightness': pulse_prior_brightness | int} }}{% else %}{}{% endif %}
            - variables:
                has_pulsed: true
        - wait_for_trigger:
            - trigger: state
              entity_id: >-
                {{ [stop_prefix ~ '1', stop_prefix ~ '2', stop_prefix ~ '3', stop_prefix ~ '4'] }}
          timeout:
            seconds: "{{ fallback_refresh_seconds }}"
  - action: "{{ notify_service }}"
    data:
      message: clear_notification
      data:
        tag: "{{ activity_tag }}"
