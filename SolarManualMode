blueprint:
  name: Live Activity - Solar Manual Mode
  description: >
    Live Activity showing grid import/export while in manual solar mode.
    Bar fills red when importing, blue when exporting, green when neither
    (capped at your kW setting). Text shows the direction, or home/solar
    use when the grid is idle. Note: iOS shows its own auto-calculated
    percentage next to the bar — that's separate from "critical_text" and
    can't be replaced, only critical_text (here used for price) is fully
    under our control.
  domain: automation
  input:
    notify_device:
      name: Mobile App Device
      selector:
        device:
          integration: mobile_app
    manual_mode_entity:
      name: Manual Mode Toggle
      default: input_boolean.toggle_solar_manual_control
      selector:
        entity:
          domain: input_boolean
    solar_entity:
      name: Solar Generation Sensor
      default: sensor.power_solar_generation_2
      selector:
        entity:
          domain: sensor
    consumption_entity:
      name: Home Consumption Sensor
      default: sensor.power_consumption_2
      selector:
        entity:
          domain: sensor
    grid_import_entity:
      name: Grid Import Sensor
      default: sensor.power_grid_import_2
      selector:
        entity:
          domain: sensor
    grid_export_entity:
      name: Grid Export Sensor
      default: sensor.power_grid_export_2
      selector:
        entity:
          domain: sensor
    import_price_entity:
      name: Import (General) Price Sensor
      default: sensor.home_general_price
      selector:
        entity:
          domain: sensor
    export_price_entity:
      name: Export (Feed-In) Price Sensor
      default: sensor.home_feed_in_price
      selector:
        entity:
          domain: sensor
    grid_power_unit:
      name: Unit of the Grid/Solar/Home Power Sensors
      description: Whether power_solar_generation_2 / power_consumption_2 / power_grid_import_2 / power_grid_export_2 report in W or kW.
      default: "W"
      selector:
        select:
          options:
            - "W"
            - "kW"
    grid_scale_max_kw:
      name: Bar Max (kW)
      description: The progress bar fills up to this many kW of import or export.
      default: 15
      selector:
        number:
          min: 1
          max: 50
          step: 0.5
          unit_of_measurement: kW
    neutral_threshold_kw:
      name: Neither Threshold (kW)
      description: Net grid flow below this magnitude counts as "neither importing nor exporting".
      default: 0.1
      selector:
        number:
          min: 0
          max: 2
          step: 0.05
          unit_of_measurement: kW
    color_import:
      name: Color (Importing)
      default: "#F44336"
      selector:
        text:
    color_export:
      name: Color (Exporting)
      default: "#2196F3"
      selector:
        text:
    color_neutral:
      name: Color (Neither)
      default: "#4CAF50"
      selector:
        text:
    update_interval:
      name: Refresh Interval (minutes)
      description: How often to refresh the stats while manual mode is on.
      default: 5
      selector:
        number:
          min: 1
          max: 60
          unit_of_measurement: min
    activity_tag:
      name: Activity Tag
      default: solar_manual
      selector:
        text:
    icon:
      name: Icon
      default: mdi:solar-power-variant
      selector:
        text:

mode: restart
max_exceeded: silent

trigger:
  - trigger: state
    entity_id: !input manual_mode_entity
    id: mode_change
  - trigger: time_pattern
    minutes: !input update_interval
    id: periodic

variables:
  manual_mode_entity: !input manual_mode_entity
  solar_entity: !input solar_entity
  consumption_entity: !input consumption_entity
  grid_import_entity: !input grid_import_entity
  grid_export_entity: !input grid_export_entity
  import_price_entity: !input import_price_entity
  export_price_entity: !input export_price_entity
  grid_power_unit: !input grid_power_unit
  grid_scale_max_kw: !input grid_scale_max_kw
  neutral_threshold_kw: !input neutral_threshold_kw
  color_import: !input color_import
  color_export: !input color_export
  color_neutral: !input color_neutral
  activity_tag: !input activity_tag
  icon: !input icon
  notify_service: >-
    {% if notify_device %}notify.mobile_app_{{ device_attr(notify_device, 'name') | slugify }}{% else %}notify.notify{% endif %}
  is_manual: "{{ is_state(manual_mode_entity, 'on') }}"
  unit_divisor: "{{ 1000 if grid_power_unit == 'W' else 1 }}"
  solar_kw: "{{ (states(solar_entity) | float(0)) / unit_divisor | float }}"
  consumption_kw: "{{ (states(consumption_entity) | float(0)) / unit_divisor | float }}"
  grid_import_kw: "{{ (states(grid_import_entity) | float(0)) / unit_divisor | float }}"
  grid_export_kw: "{{ (states(grid_export_entity) | float(0)) / unit_divisor | float }}"
  net_kw: "{{ grid_import_kw | float(0) - grid_export_kw | float(0) }}"
  is_importing: "{{ net_kw | float(0) > (neutral_threshold_kw | float(0)) }}"
  is_exporting: "{{ net_kw | float(0) < -(neutral_threshold_kw | float(0)) }}"
  flow_magnitude_kw: "{{ [net_kw | float(0) | abs, grid_scale_max_kw | float(0)] | min }}"
  import_price: >-
    {% if states(import_price_entity) not in ['unknown','unavailable',''] %}{{ '%.2f' | format(states(import_price_entity) | float(0)) }}{% else %}--{% endif %}
  export_price: >-
    {% if states(export_price_entity) not in ['unknown','unavailable',''] %}{{ '%.2f' | format(states(export_price_entity) | float(0)) }}{% else %}--{% endif %}

condition:
  # Ignore periodic ticks once manual mode is off - the mode_change trigger
  # already handles the clear-on-off case below.
  - condition: template
    value_template: "{{ trigger.id == 'mode_change' or is_manual }}"

action:
  - choose:
      - conditions:
          - condition: template
            value_template: "{{ trigger.id == 'mode_change' and not is_manual }}"
        sequence:
          - action: "{{ notify_service }}"
            data:
              message: clear_notification
              data:
                tag: "{{ activity_tag }}"
    default:
      - action: "{{ notify_service }}"
        data:
          title: Solar
          message: >-
            {% if is_importing %}Importing {{ '%.1f' | format(net_kw | float(0)) }} kW{% elif is_exporting %}Exporting {{ '%.1f' | format(net_kw | float(0) | abs) }} kW{% else %}Home {{ '%.1f' | format(consumption_kw | float(0)) }} kW · Solar {{ '%.1f' | format(solar_kw | float(0)) }} kW{% endif %}
          data:
            tag: "{{ activity_tag }}"
            live_update: true
            critical_text: >-
              {% if is_importing %}${{ import_price }}{% elif is_exporting %}${{ export_price }}{% else %}{{ '' }}{% endif %}
            progress: "{{ flow_magnitude_kw }}"
            progress_max: "{{ grid_scale_max_kw }}"
            notification_icon: "{{ icon }}"
            notification_icon_color: >-
              {% if is_importing %}{{ color_import }}{% elif is_exporting %}{{ color_export }}{% else %}{{ color_neutral }}{% endif %}
            color: >-
              {% if is_importing %}{{ color_import }}{% elif is_exporting %}{{ color_export }}{% else %}{{ color_neutral }}{% endif %}
