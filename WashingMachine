blueprint:
  name: Live Activity - Laundry (Washer / Dryer) 0.1
  description: >
    One blueprint for either the washing machine or tumble dryer - pick
    which with the Appliance dropdown, point the entities below at that
    appliance's sensors. Only pushes an update when the phase changes or
    the finish-time sensor's value changes - nothing else triggers it, so
    no spam. Uses the device-side chronometer timer (ticks on its own
    once set) built from your finish-time sensor.

    Requires Home Assistant Core 2026.7.0+ and the companion app's Live
    Activities feature (Labs, TestFlight on iOS 17.2+).
  domain: automation
  input:
    notify_device:
      name: Mobile App Device
      selector:
        device:
          integration: mobile_app
    appliance:
      name: Appliance
      description: Controls the title and default icon only - point the entities below at whichever machine you pick.
      default: "Washing Machine"
      selector:
        select:
          options:
            - "Washing Machine"
            - "Tumble Dryer"
    operation_state_entity:
      name: Operation State Sensor
      description: e.g. sensor.washing_machine or sensor.tumble_dryer - used to detect "finished", not as a trigger.
      selector:
        entity:
          domain: sensor
    program_entity:
      name: Program Sensor (optional)
      default: ""
      selector:
        entity:
          domain: sensor
    phase_entity:
      name: Program Phase Sensor
      description: e.g. sensor.washing_machine_program_phase / sensor.tumble_dryer_program_phase. Triggers an update on change.
      selector:
        entity:
          domain: sensor
    finish_time_entity:
      name: Finish Time Sensor
      description: A sensor whose state is the absolute finish date/time, e.g. sensor.washing_machine_finish. Triggers an update on change.
      selector:
        entity:
          domain: sensor
    percentage_entity:
      name: Percentage Complete Sensor (optional)
      description: If you already have one (e.g. sensor.washing_machine_percentage), it's used for the progress bar. Leave blank to skip the bar.
      default: ""
      selector:
        entity:
          domain: sensor
    door_entity:
      name: Door Sensor (optional)
      default: ""
      selector:
        entity:
          domain: binary_sensor
    finished_states:
      name: States That Mean "Finished"
      description: Comma-separated raw states of the operation state sensor.
      default: "off,finished"
      selector:
        text:
    clear_after_minutes:
      name: Auto-Clear After Finished (minutes)
      description: 0 disables auto-clear.
      default: 0
      selector:
        number:
          min: 0
          max: 120
          unit_of_measurement: min
    activity_tag:
      name: Activity Tag
      description: Must be unique - if you set this up for both washer and dryer, give each its own tag.
      default: laundry_cycle
      selector:
        text:
    icon_override:
      name: Icon Override (optional)
      description: Leave blank to auto-pick based on Appliance.
      default: ""
      selector:
        text:
    color_running:
      name: Color (Running/Waiting)
      default: "#2196F3"
      selector:
        text:
    color_finished:
      name: Color (Finished)
      default: "#4CAF50"
      selector:
        text:

mode: restart
max_exceeded: silent

trigger:
  - trigger: state
    entity_id: !input phase_entity
    id: phase
  - trigger: state
    entity_id: !input finish_time_entity
    id: finish_time

variables:
  appliance: !input appliance
  operation_state_entity: !input operation_state_entity
  program_entity: !input program_entity
  phase_entity: !input phase_entity
  finish_time_entity: !input finish_time_entity
  percentage_entity: !input percentage_entity
  door_entity: !input door_entity
  finished_states: !input finished_states
  clear_after_minutes: !input clear_after_minutes
  activity_tag: !input activity_tag
  icon_override: !input icon_override
  color_running: !input color_running
  color_finished: !input color_finished
  notify_service: >-
    {% if notify_device %}notify.mobile_app_{{ device_attr(notify_device, 'name') | slugify }}{% else %}notify.notify{% endif %}
  icon: >-
    {% if icon_override %}{{ icon_override }}{% elif appliance == 'Tumble Dryer' %}mdi:tumble-dryer{% else %}mdi:washing-machine{% endif %}
  finished_list: "{{ finished_states.split(',') | map('trim') | list }}"
  finish_time_raw: "{{ states(finish_time_entity) }}"
  finish_epoch: >-
    {% if finish_time_raw not in ['unknown','unavailable',''] %}{{ as_timestamp(finish_time_raw, default=0) | round(0) }}{% else %}0{% endif %}
  is_finished: >-
    {{ states(operation_state_entity) in finished_list or finish_epoch <= 0 }}
  program_text: "{{ states(program_entity) if program_entity and states(program_entity) not in ['unknown','unavailable',''] else '' }}"
  phase_text: "{{ states(phase_entity) if states(phase_entity) not in ['unknown','unavailable',''] else '' }}"
  door_open: "{{ door_entity and is_state(door_entity, 'on') }}"
  percentage: >-
    {% if percentage_entity and states(percentage_entity) not in ['unknown','unavailable',''] %}{{ states(percentage_entity) | float(0) | round(0) }}{% else %}none{% endif %}
  status_message: >-
    {% if program_text and phase_text %}{{ program_text }} · {{ phase_text }}{% elif phase_text %}{{ phase_text }}{% else %}Running{% endif %}{% if door_open %} · Door Open{% endif %}

action:
  # Collapse near-simultaneous phase/finish-time updates into one push.
  - delay:
      seconds: 2
  - choose:
      - conditions:
          - condition: template
            value_template: "{{ is_finished }}"
        sequence:
          - action: "{{ notify_service }}"
            data:
              title: "{{ appliance }}"
              message: "Cycle complete"
              data:
                tag: "{{ activity_tag }}"
                live_update: true
                progress: 100
                progress_max: 100
                notification_icon: "{{ icon }}"
                notification_icon_color: "{{ color_finished }}"
                color: "{{ color_finished }}"
          - if: "{{ clear_after_minutes | int(0) > 0 }}"
            then:
              - delay:
                  minutes: "{{ clear_after_minutes | int(0) }}"
              - action: "{{ notify_service }}"
                data:
                  message: clear_notification
                  data:
                    tag: "{{ activity_tag }}"
    default:
      - action: "{{ notify_service }}"
        data:
          title: "{{ appliance }}"
          message: "{{ status_message }}"
          data:
            tag: "{{ activity_tag }}"
            live_update: true
            progress: "{{ percentage if percentage != 'none' else 0 }}"
            progress_max: 100
            chronometer: true
            when: "{{ finish_epoch }}"
            when_relative: false
            notification_icon: "{{ icon }}"
            notification_icon_color: "{{ color_running }}"
            color: "{{ color_running }}"
